{
  "name": "lopam-dam-backend",
  "version": "1.0.0",
  "description": "Database Access Management (DAM) Platform Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "tsc",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "lint": "eslint src/",
    "test": "node --test src/**/*.test.js"
  },
  "keywords": [
    "database",
    "access",
    "management",
    "dam",
    "security",
    "audit"
  ],
  "author": "Lopam AI",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "prisma": "^5.19.0",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0"
  }
}
